E14.1 — Fill it, print it backwards
#include <stdio.h>
#define SIZE 6

int main(void)
{
    int numbers[SIZE];
    int i;

    for (i = 0; i < SIZE; i++)
        scanf("%d", &numbers[i]);

    for (i = 0; i < SIZE; i++)
        printf("%d ", numbers[i]);

    printf("\n");

    for (i = SIZE - 1; i >= 0; i--)
        printf("%d ", numbers[i]);

    printf("\n");

    return 0;
}


E14.2 — The four digits of your N
#include <stdio.h>
#define SIZE 4

int main(void)
{
    int N, digits[SIZE];
    int i, sum = 0;

    scanf("%d", &N);

    digits[0] = N / 1000;
    digits[1] = (N / 100) % 10;
    digits[2] = (N / 10) % 10;
    digits[3] = N % 10;

    for (i = 0; i < SIZE; i++)
    {
        printf("%d ", digits[i]);
        sum = sum + digits[i];
    }

    printf("\nSum = %d\n", sum);

    return 0;
}


🟡 MEDIOCRE
M14.1 — Above and below the average
#include <stdio.h>
#define SIZE 8

int main(void)
{
    int marks[SIZE];
    int i;
    double sum = 0.0, mean;

    for (i = 0; i < SIZE; i++)
    {
        scanf("%d", &marks[i]);
        sum = sum + marks[i];
    }

    mean = sum / SIZE;

    printf("Average = %.2f\n", mean);

    for (i = 0; i < SIZE; i++)
    {
        if (marks[i] > mean)
            printf("%d ABOVE\n", marks[i]);
        else if (marks[i] < mean)
            printf("%d BELOW\n", marks[i]);
        else
            printf("%d EQUAL\n", marks[i]);
    }

    return 0;
}


M14.2 — Write the functions, not the loops
#include <stdio.h>
#define SIZE 8

void read_marks(int a[], int n);
double average(const int a[], int n);
void report(const int a[], int n, double mean);

int main(void)
{
    int marks[SIZE];
    double mean;

    read_marks(marks, SIZE);
    mean = average(marks, SIZE);
    report(marks, SIZE, mean);

    return 0;
}

void read_marks(int a[], int n)
{
    int i;

    for (i = 0; i < n; i++)
        scanf("%d", &a[i]);
}

double average(const int a[], int n)
{
    int i, sum = 0;

    for (i = 0; i < n; i++)
        sum = sum + a[i];

    return (double) sum / n;
}

void report(const int a[], int n, double mean)
{
    int i;

    printf("Average = %.2f\n", mean);

    for (i = 0; i < n; i++)
    {
        if (a[i] > mean)
            printf("%d ABOVE\n", a[i]);
        else if (a[i] < mean)
            printf("%d BELOW\n", a[i]);
        else
            printf("%d EQUAL\n", a[i]);
    }
}


M14.3 — Partially filled array
#include <stdio.h>
#define SIZE 20

int main(void)
{
    int marks[SIZE];
    int i, count = 0, value, stop = 0;
    double sum = 0.0, mean;

    for (i = 0; i < SIZE && stop == 0; i++)
    {
        scanf("%d", &value);

        if (value < 0)
            stop = 1;
        else
        {
            marks[count] = value;
            sum = sum + marks[count];
            count++;
        }
    }

    printf("Count = %d\n", count);

    if (count > 0)
    {
        mean = sum / count;
        printf("Average = %.2f\n", mean);
    }

    printf("Array size = %d bytes\n", (int) sizeof(marks));

    return 0;
}


🔴 CHALLENGING
C14.1 — One element, two ways
#include <stdio.h>
#define SIZE 5

void bump(int *cellp);
int doubled(int value);

int main(void)
{
    int a[SIZE] = {10, 20, 30, 40, 50};
    int i, result;

    bump(&a[2]);

    for (i = 0; i < SIZE; i++)
        printf("%d ", a[i]);

    printf("\n");

    result = doubled(a[2]);

    printf("Doubled = %d\n", result);

    for (i = 0; i < SIZE; i++)
        printf("%d ", a[i]);

    printf("\n");

    return 0;
}

void bump(int *cellp)
{
    *cellp = *cellp + 1;
}

int doubled(int value)
{
    return 2 * value;
}


C14.2 — Four defects, and the one C lets you get away with
#include <stdio.h>
#define SIZE 5

int total(const int a[], int n);

int main(void)
{
    int values[SIZE] = {10, 20, 30, 40, 50};
    int i;

    for (i = 0; i < SIZE; i++)
        printf("%d ", values[i]);

    printf("\n");

    printf("total %d\n", total(values, SIZE));

    return 0;
}

int total(const int a[], int n)
{
    int i, s = 0;

    for (i = 0; i < n; i++)
        s = s + a[i];

    return s;
}
